# Configuración de Base de Datos (PostgreSQL local con Docker)
DATABASE_URL="postgresql://barber_user:barber_password@localhost:5432/barberred_db?schema=public"

# Servidor NestJS
PORT=3000
NODE_ENV=development

# JWT Secret para el Backoffice
JWT_SECRET="barberred_super_secret_jwt_key_2026"
JWT_EXPIRES_IN="7d"

# Twilio API (WhatsApp / SMS)
TWILIO_ACCOUNT_SID="AC_dummy_account_sid_for_development"
TWILIO_AUTH_TOKEN="dummy_auth_token"
TWILIO_WHATSAPP_NUMBER="whatsapp:+14155238886"
TWILIO_SMS_NUMBER="+14155238886"

# Configuración del Negocio
BUSINESS_OPEN_HOUR=10
BUSINESS_CLOSE_HOUR=20
SLOT_DURATION_MINUTES=60
